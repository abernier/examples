# Sources are versioned (src/<name>/), their builds are not — dist/<name>/ is the
# synced copy that ships.
node_modules/
package-lock.json
/src/*/dist/

.DS_Store

# Rebuilt on every deploy — previews by .github/preview.mjs, the landing page
# by ./build-home.sh (src/home/)
dist/_previews/
dist/index.html
dist/_home/
.env*

# Scratch dir the Vercel CLI builds to stage dist/ as a prebuilt output
.vercel/
