# Only the sources are versioned. dist/ is the site, and it is a build output:
# `pnpm build` (turbo, then ./sync.sh) reassembles it from examples/*/dist/, CI
# does the same on every deploy. Nothing in it is committed.
/dist/
/apps/*/dist/
/examples/*/dist/

node_modules/
package-lock.json
.turbo/

.DS_Store

.env*

# Scratch dir the Vercel CLI builds to stage dist/ as a prebuilt output
.vercel/

# Downloads landing zone: raw .glb straight off Sketchfab, before they are
# decimated and compressed into an example's own public/. Never committed —
# what ships is the processed file.
.models-in/
